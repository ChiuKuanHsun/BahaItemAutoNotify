# 複製成專案根目錄的 .env 後填寫（.env 不進版控）

# --- Discord（擇一）---
DISCORD_WEBHOOK_URL=
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=

# --- 抓取後端 ---
# 手機／住宅 IP 不會被 Cloudflare challenge，用最輕量的 requests 即可，
# 不必安裝 curl_cffi 或 playwright。
SCRAPER_BACKEND=requests

# --- 其他 ---
NOTIFY_CHANGES=true

# 執行期間是否抓 wake lock（避免抓到一半手機睡著）。
# 設 false 最省電，但排程會被 Android Doze 延後更多。
WAKE_LOCK=true
